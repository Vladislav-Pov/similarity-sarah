+# Short labels for W&B run names / tags (keys = Hydra search param paths).
+_WANDB_PARAM_ABBREV: dict[str, str] = {
+    "shared.batch_size_clients": "B",
+    "shared.num_epochs": "E",
+    "distributed_sarah.lr": "dlr",
+    "batched_nfg_sarah.theta": "th",
